# Get this from @BotFather. Never commit a real token.
BOT_TOKEN=
# Username without @, used for invitation links.
BOT_USERNAME=
# An absolute path is recommended in production.
DATABASE_PATH=data/slovo.db
# Public HTTPS address of the Mini App after Timeweb setup.
WEBAPP_URL=
# Public channel that unlocks official Slovo sets. Add the main bot as an admin.
SLOVO_CHANNEL_ID=@your_slovo_channel
SLOVO_CHANNEL_URL=https://t.me/your_slovo_channel
# Automatic synonyms and official-set translations. Results are cached in SQLite.
LANGUAGE_ENRICHMENT_ENABLED=1
# Optional compatible translation endpoint. The default is MyMemory.
TRANSLATION_API_URL=https://api.mymemory.translated.net/get
# Local testing only. Never enable this on the server.
WEBAPP_DEV_MODE=0
DEV_TELEGRAM_USER_ID=1
# Separate private reporting bot. Create it with @BotFather.
ANALYTICS_BOT_TOKEN=
# Your numeric Telegram ID; only this account can read reports.
ADMIN_TELEGRAM_ID=
# Comma-separated owner/developer/test Telegram IDs excluded from every metric.
ANALYTICS_EXCLUDED_TELEGRAM_IDS=
ANALYTICS_TIMEZONE=Europe/Moscow
