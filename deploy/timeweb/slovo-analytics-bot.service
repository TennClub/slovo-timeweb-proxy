[Unit]
Description=Slovo private Analytics Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/slovo
EnvironmentFile=/opt/slovo/.env
ExecStart=/opt/slovo/.venv/bin/python /opt/slovo/analytics_bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

